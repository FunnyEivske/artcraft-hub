{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenArt Hub",
  "version": "1.0.8",
  "identifier": "com.openart.hub",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenArt Hub",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2026 OpenArt Creative Suite",
    "publisher": "OpenArt Team",
    "shortDescription": "OpenArt Hub - Open-Source Offline Creative Suite",
    "longDescription": "OpenArt Hub is a 100% open-source, offline-first, privacy-focused creative desktop suite and launcher for PhotoCraft, VectorCraft, CADCraft, FilmCraft, Blender, Krita and your local creative projects with unified recent files and thumbnail engine.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "wix": {
        "language": "en-US",
        "bannerPath": "wix/banner.bmp",
        "dialogImagePath": "wix/dialog.bmp"
      },
      "nsis": {
        "template": "nsis/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp",
        "installerHooks": "nsis/hooks.nsh",
        "installMode": "currentUser",
        "languages": [
          "Norwegian",
          "English"
        ]
      }
    }
  }
}
{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenArt Hub",
  "version": "1.0.0",
  "identifier": "com.artcraft.hub",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenArt Hub - ArtCraft Suite",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2026 OpenArt Creative Suite",
    "publisher": "OpenArt Team",
    "shortDescription": "OpenArt Hub - Creative Desktop Suite",
    "longDescription": "OpenArt Hub controls PhotoCraft, VectorCraft, FilmCraft, Blender, Krita and your creative projects with unified recent files and thumbnail engine.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "sidebarImage": null
      }
    }
  }
}